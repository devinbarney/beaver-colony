<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    🦫 Beaver Colony
    <:subtitle>
      Beavers form colonies to build dams. Each colony keeps its business to itself.
    </:subtitle>
  </.header>

  <p>
    A small Phoenix LiveView app for learning three things: single-purpose LiveViews,
    Phoenix 1.8 Scopes, and a sidebar that knows who you are and which colony you're in.
  </p>

  <div class="flex gap-4">
    <%= if @current_scope do %>
      <.button navigate={~p"/me/colonies"} variant="primary">Go to my colonies</.button>
    <% else %>
      <.button navigate={~p"/beavers/register"} variant="primary">Become a beaver</.button>
      <.button navigate={~p"/beavers/log-in"}>Log in</.button>
    <% end %>
  </div>
</Layouts.app>
